# Use the DNS name on your broker's TLS certificate.
MQTT_URL=mqtts://homeassistant.local:8883
MQTT_USERNAME=
MQTT_PASSWORD=
# Optional private CA PEM file (relative to this directory or absolute).
MQTT_CA_FILE=
MQTT_ALLOW_LOOPBACK_PLAINTEXT=false

# Dedicated login; NEVER point this at your desktop ~/.codex directory.
# Empty uses ~/.codex-ha-bridge. Set an absolute path for a custom directory.
CODEX_BRIDGE_HOME=
# Native Codex executable; empty finds codex on PATH. Windows: use codex.exe, not a .cmd shim.
CODEX_EXECUTABLE=
CODEX_TIMEOUT_SECONDS=20
MQTT_TIMEOUT_SECONDS=10
MQTT_KEEPALIVE_SECONDS=30
SHUTDOWN_SECONDS=5

POLL_SECONDS=60
MQTT_BASE_TOPIC=codex/usage
HA_DISCOVERY_PREFIX=homeassistant
DEVICE_ID=codex_usage
DEVICE_NAME=Codex Usage
# Windows background runner enables bounded file logs automatically.
BRIDGE_LOG_TO_FILE=false
